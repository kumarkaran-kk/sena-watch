# SENA - upload this file with the site to the domain's document root.
# PHP version/handler is managed by cPanel MultiPHP Manager; do not hard-code one here.
# Enable Force HTTPS Redirect in cPanel after the domain has a valid SSL certificate.
DirectoryIndex index.php
Options -Indexes -MultiViews
AddDefaultCharset UTF-8

# Protect application internals and development artifacts, including nested dotfiles.
# Keep .well-known available for cPanel AutoSSL validation.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:app|docs|resources|tools)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "(?i)(^\.(?!well-known$)|(?:~|\.(?:bak|backup|old|orig|save|sql|sqlite|ini|log|env|md|ps1|cjs|map))$|^(?:composer|package)(?:-lock)?\.json$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Revalidate page HTML so product availability and links stay current.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
